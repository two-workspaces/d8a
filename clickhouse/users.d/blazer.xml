<clickhouse>
    <!-- Blazer's login: reads the events, cannot change or drop anything. readonly=2
         still lets it set per-query limits such as max_execution_time. -->
    <profiles>
        <blazer>
            <readonly>2</readonly>
            <max_threads>4</max_threads>
        </blazer>
    </profiles>
    <users>
        <blazer>
            <password from_env="CLICKHOUSE_BLAZER_PASSWORD"/>
            <profile>blazer</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
        </blazer>
    </users>
</clickhouse>
