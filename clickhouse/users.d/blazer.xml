<clickhouse>
    <!-- Blazer's login: may only read the d8a database. No readonly setting here: Blazer
         sends readonly=1 with every query, which a readonly profile would refuse. -->
    <profiles>
        <blazer>
            <max_threads>4</max_threads>
        </blazer>
    </profiles>
    <users>
        <blazer>
            <password from_env="CLICKHOUSE_BLAZER_PASSWORD"/>
            <profile>blazer</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants>
                <query>GRANT SELECT ON d8a.*</query>
            </grants>
        </blazer>
    </users>
</clickhouse>
